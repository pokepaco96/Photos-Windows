<Project Sdk="Microsoft.NET.Sdk">
  <!--
    End-to-end UI automation of the real PhotosWindows.exe through Windows UI Automation (FlaUI/UIA3).
    Requires an interactive, unlocked Windows desktop session. Not part of PhotosWindows.Core.slnf:
    it runs only in .github/workflows/ui-automation.yml (see docs/QA_AUTOMATION.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>PhotosWindows.UIAutomation.Tests</RootNamespace>
    <UseWindowsForms>false</UseWindowsForms>
    <!-- Automation code waits and polls; analyzer noise about ConfigureAwait/culture is not useful here. -->
    <NoWarn>$(NoWarn);CA1305;CA1307;CA1309;CA1310;CA1849;CA2201;CA1031;CA5394;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" />
    <PackageReference Include="FlaUI.Core" />
    <!-- ClrMD (MIT): managed stacks of the app when a step fails, to diagnose hangs. Test-only, not shipped. -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PhotosWindows.Application\PhotosWindows.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
