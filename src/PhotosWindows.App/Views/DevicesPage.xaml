<Page
    x:Class="PhotosWindows.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotosWindows.App.ViewModels"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <DataTemplate x:Key="DeviceTileTemplate" x:DataType="vm:DeviceItemViewModel">
            <Grid Background="{ThemeResource TilePlaceholderBrush}" CornerRadius="4">
                <FontIcon Glyph="&#xEB9F;" FontSize="22" Opacity="0.3" />
                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                <FontIcon Glyph="&#xE714;" Style="{StaticResource BadgeIconStyle}" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{x:Bind IsVideo}" />
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="4" Padding="4,1" CornerRadius="3" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                    <TextBlock Text="{x:Bind Name}" FontSize="10" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" Padding="24,8,24,12" RowSpacing="8" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock x:Uid="Devices_Title" AutomationProperties.AutomationId="Devices_Title" Text="Devices" Style="{StaticResource PageTitleStyle}" />
            <TextBlock AutomationProperties.AutomationId="Devices_Status" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock AutomationProperties.AutomationId="Devices_Summary" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Opacity="0.8" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,0,0,8">
                <ComboBox x:Uid="Devices_Device" AutomationProperties.AutomationId="Devices_Device" MinWidth="200" ItemsSource="{x:Bind ViewModel.Devices}" SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <Button x:Uid="Devices_Refresh" AutomationProperties.AutomationId="Devices_Refresh" Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                <ComboBox x:Uid="Devices_Type" AutomationProperties.AutomationId="Devices_Type" MinWidth="150" SelectedIndex="{x:Bind ViewModel.TypeIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="Devices_TypeAll" Content="Photos and videos" />
                    <ComboBoxItem x:Uid="Devices_TypePhotos" Content="Photos" />
                    <ComboBoxItem x:Uid="Devices_TypeVideos" Content="Videos" />
                </ComboBox>
                <ComboBox x:Uid="Devices_Sort" AutomationProperties.AutomationId="Devices_Sort" MinWidth="150" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="Devices_SortNewest" Content="Newest first" />
                    <ComboBoxItem x:Uid="Devices_SortOldest" Content="Oldest first" />
                    <ComboBoxItem x:Uid="Devices_SortName" Content="By name" />
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="6">
            <InfoBar x:Uid="Devices_Help" AutomationProperties.AutomationId="Devices_Help" IsOpen="{x:Bind ViewModel.ShowHelp, Mode=OneWay}" IsClosable="False" Severity="Informational"
                     Title="To see an iPhone here"
                     Message="1) Connect it with a USB cable that carries data. 2) Unlock it and keep it unlocked. 3) Tap Trust or Allow on the iPhone if it asks. 4) If Windows does not recognise it, install or update Apple Devices from the Microsoft Store. Photos that are only in iCloud and not downloaded to the iPhone cannot be read over USB. To receive the original HEIC/HEVC files, set Settings › Photos › Transfer to Mac or PC › Keep Originals on the iPhone (the wording can vary with the iOS version)." />
            <InfoBar AutomationProperties.AutomationId="Devices_Result" IsOpen="{x:Bind ViewModel.HasResult, Mode=TwoWay}" Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}"
                     Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}" />
            <!-- Plain repeater, not a ListView (a nested virtualising list froze WinUI layout on the Backup page). -->
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Visibility="{x:Bind ViewModel.HasResultLines, Mode=OneWay}">
                <ItemsRepeater AutomationProperties.AutomationId="Devices_ResultLines" x:Uid="Devices_ResultLines" AutomationProperties.Name="Details" ItemsSource="{x:Bind ViewModel.ResultLines}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </StackPanel>

        <!-- What the device exposes. Selecting does not import anything. -->
        <GridView x:Name="ItemsGrid" Grid.Row="3" AutomationProperties.AutomationId="Devices_Items" x:Uid="Devices_Items" AutomationProperties.Name="Photos and videos on the device"
                  ItemsSource="{x:Bind ViewModel.Items}" ItemTemplate="{StaticResource DeviceTileTemplate}" SelectionMode="Extended"
                  ContainerContentChanging="OnContainerContentChanging" SelectionChanged="OnSelectionChanged">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Width" Value="140" />
                    <Setter Property="Height" Value="140" />
                    <Setter Property="Margin" Value="2" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>
        <ProgressRing Grid.Row="3" AutomationProperties.AutomationId="Devices_Loading" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <!-- Preview of the single selected item, read from the device; nothing is stored. -->
        <Grid x:Name="PreviewPane" Grid.Row="3" Grid.Column="1" Width="320" RowSpacing="6" Padding="12" CornerRadius="8" Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock AutomationProperties.AutomationId="Devices_PreviewTitle" Text="{x:Bind ViewModel.PreviewTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            <Image Grid.Row="1" x:Uid="Devices_PreviewImage" AutomationProperties.AutomationId="Devices_PreviewImage" AutomationProperties.Name="Preview" Source="{x:Bind ViewModel.Preview, Mode=OneWay}" Stretch="Uniform" />
            <TextBlock Grid.Row="2" AutomationProperties.AutomationId="Devices_PreviewNote" Text="{x:Bind ViewModel.PreviewNote, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
        </Grid>

        <!-- Import -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="6">
            <TextBlock x:Uid="Devices_ModeHeader" Text="After importing" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <RadioButton x:Uid="Devices_ModeKeep" AutomationProperties.AutomationId="Devices_ModeKeep" GroupName="DeviceImportMode" Content="Keep the items on the device (nothing is changed on it)"
                         IsChecked="True" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
            <RadioButton x:Uid="Devices_ModeDelete" AutomationProperties.AutomationId="Devices_ModeDelete" GroupName="DeviceImportMode" Content="Delete from the device each item whose copy was verified"
                         IsChecked="{x:Bind ViewModel.DeleteAfterImport, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.DeleteAvailable, Mode=OneWay}" />
            <TextBlock x:Uid="Devices_DeleteUnavailable" AutomationProperties.AutomationId="Devices_DeleteUnavailable" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap"
                       Visibility="{x:Bind ViewModel.DeleteUnavailable, Mode=OneWay}"
                       Text="Deleting from the device is not available: it has not been verified to work reliably with this device and driver, so Photos Windows will not try. Delete the items on the device itself after checking your copy." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Devices_ImportSelection" AutomationProperties.AutomationId="Devices_ImportSelection" Content="Import selection" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ImportSelectionCommand}" IsEnabled="{x:Bind ViewModel.CanImportSelection, Mode=OneWay}" />
                <Button x:Uid="Devices_ImportAll" AutomationProperties.AutomationId="Devices_ImportAll" Content="Import all" Command="{x:Bind ViewModel.ImportAllCommand}" IsEnabled="{x:Bind ViewModel.CanImportAll, Mode=OneWay}" />
                <Button x:Uid="Devices_Cancel" AutomationProperties.AutomationId="Devices_Cancel" Content="Cancel" Command="{x:Bind ViewModel.CancelImportCommand}" Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}">
                <ProgressBar x:Uid="Devices_ProgressBar" AutomationProperties.AutomationId="Devices_ProgressBar" AutomationProperties.Name="Import progress" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                <TextBlock AutomationProperties.AutomationId="Devices_ProgressText" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Opacity="0.8" />
            </StackPanel>
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.Padding" Value="12,8,12,8" />
                        <Setter Target="PreviewPane.Width" Value="220" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
