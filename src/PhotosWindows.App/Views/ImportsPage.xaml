<Page
    x:Class="PhotosWindows.App.Views.ImportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotosWindows.App.ViewModels">

    <Grid Padding="24,8,24,16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Uid="Imports_Title" AutomationProperties.AutomationId="Imports_Title" Text="Imports" Style="{StaticResource PageTitleStyle}" Grid.ColumnSpan="2" />

        <ListView Grid.Row="1" AutomationProperties.AutomationId="Imports_Jobs" ItemsSource="{x:Bind ViewModel.Jobs}" SelectedItem="{x:Bind ViewModel.SelectedJobItem, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.Name="Import history">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ImportJobRow">
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Counts}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextWrapping="Wrap" />
                        <Button x:Uid="Imports_Resume" AutomationProperties.AutomationId="Imports_Resume" Content="Resume" Visibility="{x:Bind CanResume}" Click="OnResume" Tag="{x:Bind}" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="1" x:Uid="Imports_Empty" AutomationProperties.AutomationId="Imports_Empty" Text="No imports yet." Opacity="0.7" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

        <Grid Grid.Row="1" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ToggleSwitch x:Uid="Imports_ProblemsOnly" AutomationProperties.AutomationId="Imports_ProblemsOnly" Header="Show only problems" IsOn="{x:Bind ViewModel.ProblemsOnly, Mode=TwoWay}" />
            <ListView Grid.Row="1" AutomationProperties.AutomationId="Imports_Items" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" AutomationProperties.Name="Import report">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ImportItemRow">
                        <StackPanel Padding="0,6" Spacing="2">
                            <TextBlock Text="{x:Bind FileName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Message}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
