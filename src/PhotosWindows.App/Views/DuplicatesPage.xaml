<Page
    x:Class="PhotosWindows.App.Views.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotosWindows.App.ViewModels">

    <Grid Padding="24,8,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Duplicates_Title" AutomationProperties.AutomationId="Duplicates_Title" Text="Duplicates" Style="{StaticResource PageTitleStyle}" />
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,4,0,12">
            <TextBlock x:Uid="Duplicates_Help" AutomationProperties.AutomationId="Duplicates_Help" TextWrapping="Wrap" Opacity="0.8"
                       Text="Exact duplicates have identical content. Similar items look alike and are only suggestions. Keeping one item moves the others to Recently deleted; nothing is deleted automatically." />
            <ToggleSwitch x:Uid="Duplicates_IncludeSimilar" AutomationProperties.AutomationId="Duplicates_IncludeSimilar" Header="Include visually similar photos" IsOn="{x:Bind ViewModel.IncludeSimilar, Mode=TwoWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups}" AutomationProperties.AutomationId="Duplicates_Groups">
                <ItemsRepeater.Layout><StackLayout Spacing="16" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                        <StackPanel Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Spacing="8">
                            <Grid>
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                <Button HorizontalAlignment="Right" x:Uid="Duplicates_NotDuplicates" AutomationProperties.AutomationId="Duplicates_NotDuplicates" Content="Not duplicates" Click="OnDismiss" Tag="{x:Bind}" />
                            </Grid>
                            <ItemsRepeater ItemsSource="{x:Bind Candidates}">
                                <ItemsRepeater.Layout><StackLayout Orientation="Horizontal" Spacing="12" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DuplicateCandidateViewModel">
                                        <StackPanel Width="220" Spacing="4">
                                            <Grid Height="160" CornerRadius="6" Background="{ThemeResource TilePlaceholderBrush}">
                                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                            </Grid>
                                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Details}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.6" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <Button x:Uid="Duplicates_KeepThis" AutomationProperties.AutomationId="Duplicates_KeepThis" Content="Keep this one" Click="OnKeep" Tag="{x:Bind}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <TextBlock Grid.Row="2" x:Uid="Duplicates_None" AutomationProperties.AutomationId="Duplicates_None" Text="No duplicates found." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
    </Grid>
</Page>
