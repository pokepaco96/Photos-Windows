<Page
    x:Class="PhotosWindows.App.Views.MemoriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotosWindows.App.ViewModels"
    NavigationCacheMode="Required">

    <Grid x:Name="Root" Padding="24,8,24,12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Uid="Memories_Title" AutomationProperties.AutomationId="Memories_Title" Text="Memories" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="Memories_Help" AutomationProperties.AutomationId="Memories_Help" Opacity="0.75" TextWrapping="Wrap"
                           Text="Collections suggested from the dates and locations already in your library. Everything is worked out on this device with fixed rules; each card says why it is shown." />
                <TextBlock AutomationProperties.AutomationId="Memories_Summary" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Opacity="0.75" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="0,8,0,0">
                <Button x:Uid="Memories_Regenerate" AutomationProperties.AutomationId="Memories_Regenerate" Content="Regenerate" Command="{x:Bind ViewModel.RegenerateCommand}" />
                <ToggleButton x:Uid="Memories_Options" AutomationProperties.AutomationId="Memories_Options" Content="Options" IsChecked="{x:Bind ViewModel.ShowOptions, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,8,0,8">
            <InfoBar x:Uid="Memories_HiddenInfo" AutomationProperties.AutomationId="Memories_HiddenInfo" IsOpen="{x:Bind ViewModel.CanUndo, Mode=TwoWay}" Severity="Informational"
                     Message="Memory hidden. Your photos are not affected.">
                <InfoBar.ActionButton>
                    <Button x:Uid="Memories_Undo" AutomationProperties.AutomationId="Memories_Undo" Content="Undo" Command="{x:Bind ViewModel.UndoHideCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar AutomationProperties.AutomationId="Memories_Notice" IsOpen="{x:Bind ViewModel.HasNotice, Mode=TwoWay}" Severity="Success" Message="{x:Bind ViewModel.Notice, Mode=OneWay}" />
            <InfoBar x:Uid="Memories_Error" AutomationProperties.AutomationId="Memories_Error" IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Title="Memories could not be worked out" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />
        </StackPanel>

        <!-- Cards -->
        <GridView x:Name="CardsView" Grid.Row="2" AutomationProperties.AutomationId="Memories_List" x:Uid="Memories_List" AutomationProperties.Name="Memories"
                  ItemsSource="{x:Bind ViewModel.Cards}" SelectionMode="None" IsItemClickEnabled="False" ContainerContentChanging="OnCardContainerChanging">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="0,0,12,12" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Top" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:MemoryCardViewModel">
                    <Grid Width="360" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="220" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Background="{ThemeResource TilePlaceholderBrush}">
                            <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="8,2" CornerRadius="10" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind KindName}" FontSize="12" />
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="1" Padding="12" Spacing="4">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind Subtitle}" Opacity="0.8" TextWrapping="Wrap" />
                            <TextBlock x:Uid="Memory_WhyLabel" Text="Why you see this" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock Text="{x:Bind Why}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="6" RowSpacing="6" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button x:Uid="Memory_Open" AutomationProperties.AutomationId="Memory_Open" Content="Open" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Click="OnOpen" Tag="{x:Bind}" />
                                <Button Grid.Column="1" x:Uid="Memory_Slideshow" AutomationProperties.AutomationId="Memory_Slideshow" Content="Slideshow" HorizontalAlignment="Stretch" Click="OnSlideshow" Tag="{x:Bind}" />
                                <Button Grid.Row="1" x:Uid="Memory_CreateAlbum" AutomationProperties.AutomationId="Memory_CreateAlbum" Content="Create album" HorizontalAlignment="Stretch" Click="OnCreateAlbum" Tag="{x:Bind}" />
                                <Button Grid.Row="1" Grid.Column="1" x:Uid="Memory_Hide" AutomationProperties.AutomationId="Memory_Hide" Content="Hide" HorizontalAlignment="Stretch" Click="OnHide" Tag="{x:Bind}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel Grid.Row="2" MaxWidth="480" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon Glyph="&#xE81C;" FontSize="40" Opacity="0.5" />
            <TextBlock AutomationProperties.AutomationId="Memories_EmptyTitle" Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock AutomationProperties.AutomationId="Memories_EmptyMessage" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Opacity="0.75" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <ProgressRing Grid.Row="2" AutomationProperties.AutomationId="Memories_Loading" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <!-- Options: preference, exclusions, hidden memories -->
        <ScrollViewer x:Name="OptionsPane" Grid.Row="2" Grid.Column="1" Width="320" Visibility="{x:Bind ViewModel.ShowOptions, Mode=OneWay}">
            <StackPanel Padding="12" Spacing="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <TextBlock x:Uid="Memories_OptionsTitle" AutomationProperties.AutomationId="Memories_OptionsTitle" Text="Options" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Uid="Memories_CloseOptions" AutomationProperties.AutomationId="Memories_CloseOptions" AutomationProperties.Name="Close options" ToolTipService.ToolTip="Close"
                            HorizontalAlignment="Right" Width="32" Height="32" Padding="0" Command="{x:Bind ViewModel.ToggleOptionsCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <ToggleSwitch x:Uid="Memories_PreferFavorites" AutomationProperties.AutomationId="Memories_PreferFavorites" Header="Choose favourites and edited photos first"
                              IsOn="{x:Bind ViewModel.PreferFavorites, Mode=TwoWay}" />
                <TextBlock x:Uid="Memories_ExcludeKindLabel" Text="Do not suggest this kind of memory" TextWrapping="Wrap" />
                <ComboBox x:Uid="Memories_KindCombo" AutomationProperties.AutomationId="Memories_KindCombo" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind ViewModel.Kinds, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedKind, Mode=TwoWay}" />
                <Button x:Uid="Memories_ExcludeKind" AutomationProperties.AutomationId="Memories_ExcludeKind" Content="Exclude kind" Command="{x:Bind ViewModel.ExcludeKindCommand}" />
                <TextBlock x:Uid="Memories_ExcludeRangeLabel" Text="Never use photos taken between these days" TextWrapping="Wrap" Margin="0,6,0,0" />
                <CalendarDatePicker x:Uid="Memories_RangeFrom" AutomationProperties.AutomationId="Memories_RangeFrom" PlaceholderText="From" HorizontalAlignment="Stretch" Date="{x:Bind ViewModel.RangeFrom, Mode=TwoWay}" />
                <CalendarDatePicker x:Uid="Memories_RangeTo" AutomationProperties.AutomationId="Memories_RangeTo" PlaceholderText="To" HorizontalAlignment="Stretch" Date="{x:Bind ViewModel.RangeTo, Mode=TwoWay}" />
                <Button x:Uid="Memories_ExcludeRange" AutomationProperties.AutomationId="Memories_ExcludeRange" Content="Exclude days" Command="{x:Bind ViewModel.ExcludeRangeCommand}" />
                <TextBlock x:Uid="Memories_ExclusionsHeader" Text="Exclusions and hidden memories" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock x:Uid="Memories_NoExclusions" AutomationProperties.AutomationId="Memories_NoExclusions" Text="Nothing is excluded or hidden." Opacity="0.7" Visibility="{x:Bind ViewModel.NoDecisions, Mode=OneWay}" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Decisions}">
                    <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:MemoryDecisionViewModel">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock AutomationProperties.AutomationId="Memories_DecisionText" Text="{x:Bind Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Uid="Memories_Restore" AutomationProperties.AutomationId="Memories_Restore" Content="Restore" Click="OnRestore" Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="Root.Padding" Value="12,8,12,8" />
                        <Setter Target="OptionsPane.Width" Value="260" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
