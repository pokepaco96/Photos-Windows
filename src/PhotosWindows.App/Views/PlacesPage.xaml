<Page
    x:Class="PhotosWindows.App.Views.PlacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PhotosWindows.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <DataTemplate x:Key="PlaceTileTemplate" x:DataType="vm:AssetItemViewModel">
            <Grid Background="{ThemeResource TilePlaceholderBrush}" CornerRadius="4" AutomationProperties.Name="{x:Bind AutomationName}">
                <FontIcon Glyph="&#xEB9F;" FontSize="24" Opacity="0.35" Visibility="{x:Bind ThumbnailFailed, Mode=OneWay}" />
                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                <FontIcon Glyph="&#xE714;" Style="{StaticResource BadgeIconStyle}" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="{x:Bind IsVideo}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="Root" Padding="24,8,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title, summary and map/list switches -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Uid="Places_Title" AutomationProperties.AutomationId="Places_Title" Text="Places" Style="{StaticResource PageTitleStyle}" />
                <TextBlock AutomationProperties.AutomationId="Places_Summary" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                <ToggleButton x:Uid="Places_ListToggle" AutomationProperties.AutomationId="Places_ListToggle" Content="List"
                              IsChecked="{x:Bind ViewModel.IsListMode, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsMapEnabled, Mode=OneWay}" />
                <ToggleSwitch x:Uid="Places_MapSwitch" AutomationProperties.AutomationId="Places_MapSwitch" OnContent="Map on" OffContent="Map off"
                              MinWidth="0" IsOn="{x:Bind ViewModel.IsMapEnabled, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- Filters (scrolls horizontally in narrow windows) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,4">
            <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,0,0,8">
                <ComboBox x:Uid="Places_Year" AutomationProperties.AutomationId="Places_Year" MinWidth="130" PlaceholderText="Custom range"
                          ItemsSource="{x:Bind ViewModel.Years}" SelectedIndex="{x:Bind ViewModel.YearIndex, Mode=TwoWay}" />
                <CalendarDatePicker x:Uid="Places_From" AutomationProperties.AutomationId="Places_From" PlaceholderText="From" MinWidth="140"
                                    Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}" />
                <CalendarDatePicker x:Uid="Places_To" AutomationProperties.AutomationId="Places_To" PlaceholderText="To" MinWidth="140"
                                    Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}" />
                <ComboBox x:Uid="Places_Type" AutomationProperties.AutomationId="Places_Type" MinWidth="130" SelectedIndex="{x:Bind ViewModel.MediaTypeIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="Places_TypeAll" Content="Photos and videos" />
                    <ComboBoxItem x:Uid="Places_TypePhotos" Content="Photos" />
                    <ComboBoxItem x:Uid="Places_TypeVideos" Content="Videos" />
                </ComboBox>
                <ComboBox x:Uid="Places_Album" AutomationProperties.AutomationId="Places_Album" MinWidth="150" ItemsSource="{x:Bind ViewModel.Albums}"
                          SelectedItem="{x:Bind ViewModel.SelectedAlbum, Mode=TwoWay}" />
                <ToggleButton AutomationProperties.AutomationId="Places_Favorites" x:Uid="Places_Favorites" IsChecked="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xEB51;" FontSize="14" />
                        <TextBlock x:Uid="Places_FavoritesText" Text="Favorites" />
                    </StackPanel>
                </ToggleButton>
                <Button x:Uid="Places_ClearFilters" AutomationProperties.AutomationId="Places_ClearFilters" Content="Clear filters"
                        Command="{x:Bind ViewModel.ClearFiltersCommand}" Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Notices -->
        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar AutomationProperties.AutomationId="Places_NoGpsInfo" IsOpen="{x:Bind ViewModel.HasWithoutLocation, Mode=OneWay}" IsClosable="False" Severity="Informational"
                     Message="{x:Bind ViewModel.WithoutLocationText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="Places_ShowWithoutLocation" AutomationProperties.AutomationId="Places_ShowWithoutLocation" Content="Show them" Command="{x:Bind ViewModel.ShowWithoutLocationCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Uid="Places_MapUnavailable" AutomationProperties.AutomationId="Places_MapUnavailable" IsOpen="{x:Bind ViewModel.MapUnavailable, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="Map unavailable" Message="The built-in map could not be loaded. Places are shown as a list." />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Map: basemap bitmap + accessible cluster buttons -->
            <Grid x:Name="MapHost" AutomationProperties.AutomationId="Places_Map" x:Uid="Places_Map" AutomationProperties.Name="Map"
                  CornerRadius="8" IsTabStop="True" UseSystemFocusVisuals="True" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  Visibility="{x:Bind ViewModel.ShowMap, Mode=OneWay}"
                  SizeChanged="OnMapSizeChanged" PointerPressed="OnMapPointerPressed" PointerMoved="OnMapPointerMoved" PointerReleased="OnMapPointerReleased"
                  PointerCanceled="OnMapPointerReleased" PointerWheelChanged="OnMapWheel" DoubleTapped="OnMapDoubleTapped" KeyDown="OnMapKeyDown">
                <Image x:Name="MapImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                <Canvas x:Name="ClusterLayer" />
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Spacing="4">
                    <Button x:Uid="Places_ZoomIn" AutomationProperties.AutomationId="Places_ZoomIn" AutomationProperties.Name="Zoom in" ToolTipService.ToolTip="Zoom in" Click="OnZoomIn" Width="36" Height="36" Padding="0">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>
                    <Button x:Uid="Places_ZoomOut" AutomationProperties.AutomationId="Places_ZoomOut" AutomationProperties.Name="Zoom out" ToolTipService.ToolTip="Zoom out" Click="OnZoomOut" Width="36" Height="36" Padding="0">
                        <FontIcon Glyph="&#xE738;" FontSize="14" />
                    </Button>
                    <Button x:Uid="Places_FitAll" AutomationProperties.AutomationId="Places_FitAll" AutomationProperties.Name="Show all places" ToolTipService.ToolTip="Show all places" Click="OnFitAll" Width="36" Height="36" Padding="0">
                        <FontIcon Glyph="&#xE9A6;" FontSize="14" />
                    </Button>
                </StackPanel>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="6,2" CornerRadius="4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                    <TextBlock AutomationProperties.AutomationId="Places_Attribution" Text="{x:Bind ViewModel.Attribution}" FontSize="11" />
                </Border>
            </Grid>

            <!-- List mode: one row per area, newest first -->
            <ListView x:Name="PlacesList" AutomationProperties.AutomationId="Places_List" x:Uid="Places_List" AutomationProperties.Name="Places"
                      ItemsSource="{x:Bind ViewModel.Groups}" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnGroupClicked"
                      ContainerContentChanging="OnGroupContainerChanging" Visibility="{x:Bind ViewModel.ShowList, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaceGroupViewModel">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="64" Height="64" CornerRadius="6" Background="{ThemeResource TilePlaceholderBrush}">
                                <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="UniformToFill" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind CountText}" Opacity="0.8" />
                                <TextBlock Text="{x:Bind Dates}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <StackPanel AutomationProperties.AutomationId="Places_Empty" MaxWidth="480" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <FontIcon Glyph="&#xE707;" FontSize="40" Opacity="0.5" />
                <TextBlock AutomationProperties.AutomationId="Places_EmptyTitle" Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock AutomationProperties.AutomationId="Places_EmptyMessage" Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" Opacity="0.75" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <Button x:Uid="Places_EmptyClearFilters" AutomationProperties.AutomationId="Places_EmptyClearFilters" Content="Clear filters" HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.ClearFiltersCommand}" Visibility="{x:Bind ViewModel.HasFilters, Mode=OneWay}" />
            </StackPanel>
            <ProgressRing AutomationProperties.AutomationId="Places_Loading" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <!-- Tray with the photos of the selected area -->
            <Grid x:Name="Tray" Grid.Column="1" Width="320" AutomationProperties.AutomationId="Places_Tray" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                  Padding="12" RowSpacing="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock AutomationProperties.AutomationId="Places_TrayTitle" Text="{x:Bind ViewModel.Selected.Title, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock AutomationProperties.AutomationId="Places_TrayCount" Text="{x:Bind ViewModel.Selected.CountText, Mode=OneWay, FallbackValue=''}" Opacity="0.8" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Dates, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" />
                    </StackPanel>
                    <Button x:Uid="Places_CloseTray" AutomationProperties.AutomationId="Places_CloseTray" AutomationProperties.Name="Close" ToolTipService.ToolTip="Close"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Padding="0" Command="{x:Bind ViewModel.ClearSelectionCommand}">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1" x:Uid="Places_Approximate" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" TextWrapping="Wrap"
                           Text="Coordinates are approximate: the area is shown, never an address." />
                <GridView x:Name="TrayGrid" Grid.Row="2" AutomationProperties.AutomationId="Places_TrayGrid" x:Uid="Places_TrayGrid" AutomationProperties.Name="Photos in this area"
                          ItemsSource="{x:Bind ViewModel.Tray}" ItemTemplate="{StaticResource PlaceTileTemplate}" SelectionMode="Single"
                          ContainerContentChanging="OnTrayContainerChanging" DoubleTapped="OnTrayDoubleTapped" KeyDown="OnTrayKeyDown" SelectionChanged="OnTraySelectionChanged">
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                            <Setter Property="Width" Value="90" />
                            <Setter Property="Height" Value="90" />
                            <Setter Property="Margin" Value="2" />
                        </Style>
                    </GridView.ItemContainerStyle>
                </GridView>
                <StackPanel Grid.Row="3" Spacing="6">
                    <Button HorizontalAlignment="Stretch" x:Name="OpenPhotoButton" x:Uid="Places_OpenPhoto" AutomationProperties.AutomationId="Places_OpenPhoto" Content="Open" IsEnabled="False" Click="OnOpenPhoto" Style="{StaticResource AccentButtonStyle}" />
                    <Button HorizontalAlignment="Stretch" x:Uid="Places_ZoomToSelection" AutomationProperties.AutomationId="Places_ZoomToSelection" Content="Zoom to area" Command="{x:Bind ViewModel.ZoomToSelectionCommand}" IsEnabled="{x:Bind ViewModel.IsMapEnabled, Mode=OneWay}" />
                    <Button HorizontalAlignment="Stretch" x:Uid="Places_RemoveLocation" AutomationProperties.AutomationId="Places_RemoveLocation" Content="Remove location" Command="{x:Bind ViewModel.RemoveLocationCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Small windows: a narrower tray, still beside the map so it never covers the zoom controls. -->
                        <Setter Target="Tray.Width" Value="230" />
                        <Setter Target="Root.Padding" Value="12,8,12,8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
