<Page
    x:Class="PhotosWindows.App.Views.BackupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer x:Name="Root" Padding="24,8,24,12">
        <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock x:Uid="BackupPage_Title" AutomationProperties.AutomationId="BackupPage_Title" Text="Backup" Style="{StaticResource PageTitleStyle}" />

            <!-- 1. Originals backup: plain folders with every original file -->
            <StackPanel Padding="16" Spacing="10" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Uid="Backup_OriginalsHeader" AutomationProperties.AutomationId="Backup_OriginalsHeader" Text="Backup of photos and videos (originals)" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Uid="Backup_OriginalsHelp" AutomationProperties.AutomationId="Backup_OriginalsHelp" TextWrapping="Wrap" Opacity="0.8"
                           Text="Copies the original file of every item in the library, including those added without moving, to a folder you choose. Files are copied exactly as they are (no compression or conversion), sorted into YEAR/MONTH folders, and each copy is verified. The result is a normal folder you can open from File Explorer. It does not contain albums or edits: use the library backup below for that." />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Uid="Backup_DestinationLabel" Text="Destination" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        <TextBlock AutomationProperties.AutomationId="Backup_Destination" Text="{x:Bind ViewModel.Destination, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock AutomationProperties.AutomationId="Backup_Space" Text="{x:Bind ViewModel.SpaceText, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" x:Uid="Backup_ChooseDestination" AutomationProperties.AutomationId="Backup_ChooseDestination" Content="Choose destination…" VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ChooseDestinationCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                </Grid>

                <TextBlock AutomationProperties.AutomationId="Backup_Analysis" Text="{x:Bind ViewModel.Analysis, Mode=OneWay}" TextWrapping="Wrap" />
                <InfoBar AutomationProperties.AutomationId="Backup_Blocker" IsOpen="{x:Bind ViewModel.HasBlocker, Mode=OneWay}" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.Blocker, Mode=OneWay}" />
                <InfoBar AutomationProperties.AutomationId="Backup_Warning" IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind ViewModel.Warning, Mode=OneWay}" />
                <CheckBox x:Uid="Backup_AcceptIncomplete" AutomationProperties.AutomationId="Backup_AcceptIncomplete" Content="Copy only the available files. The result will be marked as incomplete."
                          IsChecked="{x:Bind ViewModel.AcceptIncomplete, Mode=TwoWay}" Visibility="{x:Bind ViewModel.CanAcceptIncomplete, Mode=OneWay}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="Backup_Start" AutomationProperties.AutomationId="Backup_Start" Content="Create backup of originals" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.StartCommand}" IsEnabled="{x:Bind ViewModel.CanStart, Mode=OneWay}" />
                    <Button x:Uid="Backup_Resume" AutomationProperties.AutomationId="Backup_Resume" Content="Resume unfinished backup"
                            Command="{x:Bind ViewModel.ResumeCommand}" Visibility="{x:Bind ViewModel.CanResume, Mode=OneWay}" />
                    <Button x:Uid="Backup_Cancel" AutomationProperties.AutomationId="Backup_Cancel" Content="Cancel"
                            Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}" />
                    <Button x:Uid="Backup_VerifyExisting" AutomationProperties.AutomationId="Backup_VerifyExisting" Content="Verify an existing backup…"
                            Command="{x:Bind ViewModel.VerifyExistingCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay}">
                    <ProgressBar x:Uid="Backup_ProgressBar" AutomationProperties.AutomationId="Backup_ProgressBar" AutomationProperties.Name="Backup progress" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
                    <TextBlock AutomationProperties.AutomationId="Backup_ProgressText" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Opacity="0.8" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar AutomationProperties.AutomationId="Backup_Result" IsOpen="{x:Bind ViewModel.HasResult, Mode=TwoWay}" Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}"
                         Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}" Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="Backup_OpenFolder" AutomationProperties.AutomationId="Backup_OpenFolder" Content="Open backup folder"
                                Command="{x:Bind ViewModel.OpenFolderCommand}" Visibility="{x:Bind ViewModel.CanOpenFolder, Mode=OneWay}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasProblems, Mode=OneWay}">
                    <TextBlock x:Uid="Backup_ProblemsHeader" Text="Files with problems" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView AutomationProperties.AutomationId="Backup_Problems" x:Uid="Backup_Problems" AutomationProperties.Name="Files with problems" ItemsSource="{x:Bind ViewModel.Problems}" SelectionMode="None" MaxHeight="180" />
                </StackPanel>

                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay}">
                    <TextBlock x:Uid="Backup_HistoryHeader" Text="Latest backups from this PC" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView AutomationProperties.AutomationId="Backup_History" x:Uid="Backup_History" AutomationProperties.Name="Latest backups" ItemsSource="{x:Bind ViewModel.History}" SelectionMode="None" MaxHeight="160" />
                </StackPanel>
            </StackPanel>

            <!-- 2. Library backup (restorable): unchanged, lives in Settings -->
            <StackPanel Padding="16" Spacing="8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock x:Uid="Backup_LibraryHeader" AutomationProperties.AutomationId="Backup_LibraryHeader" Text="Photos Windows library backup (restorable)" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Uid="Backup_LibraryHelp" TextWrapping="Wrap" Opacity="0.8"
                           Text="Saves the catalog (albums, keywords, edits, favourites) and, optionally, the originals copied into the library. It is what you restore to get the whole library back. It does not include files added without moving: use the backup of originals above for those." />
                <Button x:Uid="Backup_OpenLibraryBackup" AutomationProperties.AutomationId="Backup_OpenLibraryBackup" Content="Open library backup and restore in Settings" Command="{x:Bind ViewModel.OpenLibraryBackupCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
