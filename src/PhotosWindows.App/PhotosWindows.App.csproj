<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>PhotosWindows.App</RootNamespace>
    <AssemblyName>PhotosWindows</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained Windows App SDK: runs from a folder without installing the runtime (ADR-0009). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Required for unpackaged apps so the app's resources.pri (compiled XAML + strings) is produced and published. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Unpackaged apps look up resources.pri (then <exe>.pri); without this the file is named after the project and x:Uid lookups fail at runtime. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <!-- UI code is only compiled on Windows CI; analyzer noise from generated XAML code is not promoted to errors. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier Condition="'$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' != 'ARM64'">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotosWindows.Infrastructure\PhotosWindows.Infrastructure.csproj" />
    <ProjectReference Include="..\PhotosWindows.Imaging\PhotosWindows.Imaging.csproj" />
    <ProjectReference Include="..\PhotosWindows.Platform.Windows\PhotosWindows.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- XAML sources embedded for XamlDiagnostics (precise errors if a compiled page fails to load). -->
    <EmbeddedResource Include="**\*.xaml" Exclude="bin\**;obj\**" LogicalName="xaml/%(Filename)%(Extension)" />
  </ItemGroup>
  <!--
    Safety net: the published app cannot start without its resources.pri and compiled XAML (.xbf); WinUI only reports
    "XAML parsing failed". Copy them from the build output if the publish pipeline left them out.
  -->
  <Target Name="EnsureXamlResourcesInPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PwXamlRuntimeFiles Include="$(OutDir)resources.pri;$(OutDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_PwXamlRuntimeFiles)" DestinationFiles="@(_PwXamlRuntimeFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_PwXamlRuntimeFiles)' != ''" />
    <Error Condition="!Exists('$(PublishDir)resources.pri')" Text="resources.pri is missing from the publish folder; the app would fail to start (XAML parsing failed)." />
  </Target>
</Project>
