<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#FFE6E6E6" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#99000000" />
            <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#FFF3F3F3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#FF2B2B2B" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#99000000" />
            <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="#FF101010" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="TilePlaceholderBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ViewerBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,24,0,8" />
    </Style>

    <Style x:Key="BadgeIconStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
</ResourceDictionary>
