<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PhotosWindows.Imaging</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotosWindows.Application\PhotosWindows.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Natural Earth basemap (public domain), generated by tools/basemap/build_basemap.py. -->
    <EmbeddedResource Include="Maps\world.pwmap" LogicalName="PhotosWindows.Maps.world.pwmap" />
    <None Include="Maps\world.manifest.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PhotosWindows.Imaging.Tests" />
  </ItemGroup>
</Project>
